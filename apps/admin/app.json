{
  "expo": {
    "name": "CanteenX Admin",
    "slug": "canteenx-admin",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.canteenx.admin"
    },
    "android": {
      "package": "com.canteenx.admin",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
